generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  username       String    @unique
  email          String    @unique
  password       String
  profilePicture String?   @default("") @map("profile_image")
  role           String    @default("user")
  createdAt      DateTime?
  updatedAt      DateTime?
}

model Recipe {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  image       String?
  prepTime    Int?
  cookTime    Int?
  servings    Int?
  category    String?
  ingredients String[]
  steps       Json
  createdAt   DateTime?
  updatedAt   DateTime?
}

